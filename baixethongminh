    name: "Vincom Plaza Lê Thánh Tông",
    address: "Số 1 Lê Thánh Tông",
    lat: 20.857,
    lng: 106.685,
    price: 20000,
  },
];

// --- DỮ LIỆU SƠ ĐỒ 24 Ô ĐỖ XE CHÂN THỰC ---
const INITIAL_SLOTS = [
  ...Array.from({ length: 12 }, (_, i) => ({
    id: `A${i + 1}`,
    status: [1, 4, 7, 10].includes(i) ? "OCCUPIED" : "AVAILABLE",
  })),
  ...Array.from({ length: 12 }, (_, i) => ({
    id: `B${i + 1}`,
    status: [0, 3, 6, 8, 9].includes(i) ? "OCCUPIED" : "AVAILABLE",
  })),
];

