                      className="px-3 py-2 bg-slate-100 text-blue-600 rounded-xl text-sm font-semibold hover:bg-slate-200 flex items-center"
                    >
                      <MapPin size={16} className="mr-1" /> Chỉ đường
                    </button>
                    <button
                      onClick={() => handleSelectLot(lot)}
                      className="px-4 py-2 bg-blue-600 text-white rounded-xl text-sm font-semibold hover:bg-blue-700 shadow-md shadow-blue-600/20"
                    >
                      Chọn
                    </button>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    );
  }

  // --- UI: MÀN HÌNH ĐẶT CHỖ (SƠ ĐỒ THỰC TẾ & FORM) ---
  if (screen === "BOOKING") {
    return (
      <div className="min-h-screen bg-slate-900 flex flex-col relative font-sans">
        {/* Header Tối màu (Dark Mode Header) */}
        <div className="bg-slate-800 px-4 py-4 flex items-center gap-3 border-b border-slate-700 sticky top-0 z-20 shadow-md">
          <button
            onClick={() => setScreen("LOTS")}
            className="p-2 bg-slate-700 rounded-full text-white hover:bg-slate-600 transition"
          >
            <ChevronLeft size={20} />
          </button>
          <div>
            <h2 className="font-bold text-lg text-white">{selectedLot.name}</h2>
            <p className="text-xs text-slate-400">
              Giá: {selectedLot.price.toLocaleString()}đ / giờ
            </p>
          </div>
        </div>

        {/* Bãi đỗ xe thực tế (Kéo cuộn dọc) */}
        <div className="flex-1 overflow-y-auto pb-64 pt-6 px-2 relative">
          {/* Lối Vào */}
          <div className="flex justify-center mb-8 relative z-10">
            <div className="bg-yellow-500/20 border-2 border-yellow-500 text-yellow-500 px-8 py-2 rounded-lg font-bold text-sm tracking-widest flex items-center gap-2 shadow-[0_0_15px_rgba(234,179,8,0.2)]">
              <span className="animate-pulse">↓</span> LỐI VÀO{" "}
              <span className="animate-pulse">↓</span>
            </div>
          </div>

          {/* Cấu trúc Đường & Ô đỗ */}
          <div className="flex justify-center max-w-sm mx-auto relative">
            {/* Cột A (Trái) */}
            <div className="flex flex-col">
              {slots
                .filter((s) => s.id.startsWith("A"))
                .map((slot, index) => {
                  const isAvailable = slot.status === "AVAILABLE";
                  const isSelected = selectedSlot === slot.id;
                  const isFirst = index === 0;

                  return (
                    <div
                      key={slot.id}
                      onClick={() => isAvailable && setSelectedSlot(slot.id)}
                      className={`h-24 w-28 sm:w-32 relative flex items-center justify-center transition-all ${isAvailable ? "cursor-pointer" : ""} 
                      border-b-4 border-l-4 border-white/80 rounded-l-md 
                      ${isFirst ? "border-t-4" : "-mt-[4px]"}
                      ${
                        isSelected
                          ? "bg-blue-500/40 shadow-[inset_0_0_30px_rgba(59,130,246,0.6)]"
                          : isAvailable
                            ? "hover:bg-white/5"
                            : "bg-slate-800/60"
                      }
                    `}
                    >
                      {/* Chữ sơn trên mặt đường */}
                      {isAvailable && !isSelected && (
                        <span className="text-3xl font-black text-slate-700/60 rotate-[-90deg] tracking-tighter select-none">
                          {slot.id}
                        </span>
                      )}

                      {/* Trạng thái Đang chọn */}
                      {isSelected && (
                        <span className="text-xl font-bold text-white shadow-lg bg-blue-600 px-3 py-1 rounded-full z-10 animate-bounce">
                          CHỌN
                        </span>
                      )}

                      {/* Xe đang đỗ */}
                      {!isAvailable && (
                        <div className="absolute inset-0 flex items-center justify-center">
                          <Car
                            size={64}
                            strokeWidth={1}
                            className="text-rose-400 rotate-[-90deg] drop-shadow-[0_5px_5px_rgba(0,0,0,0.5)] fill-rose-500/20"
                          />
                        </div>
                      )}
                    </div>
                  );
                })}
            </div>

            {/* Lối đi ở giữa (Driveway) */}
            <div className="w-20 sm:w-28 flex flex-col items-center relative">
              {/* Vạch kẻ đường đứt đoạn màu vàng */}
              <div className="absolute inset-y-0 w-0 border-l-[4px] border-dashed border-yellow-500/70"></div>
              {/* Mũi tên chỉ hướng */}
              <div className="text-yellow-500/40 text-4xl absolute top-12">
                ↓
              </div>
              <div className="text-yellow-500/40 text-4xl absolute top-1/2 -translate-y-1/2">
                ↓
              </div>
              <div className="text-yellow-500/40 text-4xl absolute bottom-12">
                ↓
              </div>
            </div>

            {/* Cột B (Phải) */}
            <div className="flex flex-col">
              {slots
                .filter((s) => s.id.startsWith("B"))
                .map((slot, index) => {
                  const isAvailable = slot.status === "AVAILABLE";
                  const isSelected = selectedSlot === slot.id;
                  const isFirst = index === 0;

                  return (
                    <div
                      key={slot.id}
                      onClick={() => isAvailable && setSelectedSlot(slot.id)}
                      className={`h-24 w-28 sm:w-32 relative flex items-center justify-center transition-all ${isAvailable ? "cursor-pointer" : ""} 
                      border-b-4 border-r-4 border-white/80 rounded-r-md 
                      ${isFirst ? "border-t-4" : "-mt-[4px]"}
                      ${
                        isSelected
                          ? "bg-blue-500/40 shadow-[inset_0_0_30px_rgba(59,130,246,0.6)]"
                          : isAvailable
                            ? "hover:bg-white/5"
                            : "bg-slate-800/60"
                      }
                    `}
                    >
                      {/* Chữ sơn trên mặt đường */}
                      {isAvailable && !isSelected && (
                        <span className="text-3xl font-black text-slate-700/60 rotate-90 tracking-tighter select-none">
                          {slot.id}
                        </span>
                      )}

                      {/* Trạng thái Đang chọn */}
                      {isSelected && (
                        <span className="text-xl font-bold text-white shadow-lg bg-blue-600 px-3 py-1 rounded-full z-10 animate-bounce">
                          CHỌN
                        </span>
                      )}

                      {/* Xe đang đỗ */}
                      {!isAvailable && (
                        <div className="absolute inset-0 flex items-center justify-center">
                          <Car
                            size={64}
                            strokeWidth={1}
                            className="text-emerald-400 rotate-90 drop-shadow-[0_5px_5px_rgba(0,0,0,0.5)] fill-emerald-500/20"
                          />
                        </div>
                      )}
                    </div>
                  );
                })}
            </div>
          </div>
        </div>

        {/* Panel Đặt chỗ (Fixed Bottom) */}
        <div className="fixed bottom-0 left-0 right-0 bg-white rounded-t-3xl shadow-[0_-10px_40px_rgba(0,0,0,0.3)] p-6 z-30 transition-transform duration-300">
          <div className="w-12 h-1.5 bg-slate-200 rounded-full mx-auto mb-5"></div>

          <form
            onSubmit={handleBookingSubmit}
            className="max-w-md mx-auto space-y-4"
          >
            <div className="flex gap-4">
              <div className="flex-1">
                <label className="text-xs font-bold text-slate-500 uppercase mb-1 block">
                  Biển số xe
                </label>
                <input
                  type="text"
                  required
                  placeholder="15A-123.45"
                  className="w-full bg-slate-100 border-2 border-slate-200 rounded-xl p-3 outline-none focus:border-blue-500 focus:bg-white uppercase font-mono text-center text-lg tracking-widest font-bold text-slate-800 transition"
                  value={bookingForm.plate}
                  onChange={(e) =>
                    setBookingForm({
                      ...bookingForm,
                      plate: e.target.value.toUpperCase(),
                    })
                  }
                />
              </div>
              <div className="w-1/3">
                <label className="text-xs font-bold text-slate-500 uppercase mb-1 block">
                  Giờ đỗ
                </label>
                <div className="relative">
                  <select
                    className="w-full bg-slate-100 border-2 border-slate-200 rounded-xl p-3 outline-none focus:border-blue-500 focus:bg-white font-bold text-slate-800 appearance-none text-center"
                    value={bookingForm.duration}
                    onChange={(e) =>
                      setBookingForm({
                        ...bookingForm,
                        duration: parseInt(e.target.value),
                      })
                    }
                  >
                    {[1, 2, 3, 4, 5, 6, 12, 24].map((h) => (
                      <option key={h} value={h}>
                        {h} giờ
                      </option>
                    ))}
                  </select>
                  <Clock
                    size={16}
                    className="absolute right-3 top-3.5 text-slate-400 pointer-events-none"
                  />
                </div>
              </div>
            </div>

            <button
              type="submit"
              disabled={!selectedSlot}
              className={`w-full font-bold py-4 rounded-xl shadow-lg flex justify-between items-center px-6 transition-all ${
                selectedSlot
                  ? "bg-blue-600 hover:bg-blue-700 text-white shadow-blue-600/30 active:scale-[0.98]"
                  : "bg-slate-200 text-slate-400 cursor-not-allowed shadow-none"
              }`}
            >
              <span>
                {selectedSlot
                  ? `Xác nhận đặt ô ${selectedSlot}`
                  : "Vui lòng chọn 1 ô đỗ"}
              </span>
              {selectedSlot && (
                <span className="text-xl">
                  {(selectedLot.price * bookingForm.duration).toLocaleString()}đ
                </span>
              )}
            </button>
          </form>
        </div>
      </div>
    );
  }

  // --- UI: MÀN HÌNH ĐẶT THÀNH CÔNG (CÓ QR) ---
  if (screen === "SUCCESS") {
    return (
      <div className="min-h-screen bg-blue-600 flex flex-col items-center justify-center p-4">
        <div className="w-full max-w-sm bg-white rounded-3xl shadow-2xl p-8 text-center relative overflow-hidden">
          {/* Decorative background circle */}
          <div className="absolute -top-12 -right-12 w-32 h-32 bg-emerald-50 rounded-full blur-2xl"></div>

          <div className="w-20 h-20 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4 relative z-10">
            <CheckCircle2 size={40} className="text-emerald-500" />
          </div>

          <h2 className="text-2xl font-bold text-slate-800 mb-1">
            Đặt chỗ thành công!
          </h2>
          <p className="text-slate-500 text-sm mb-6">
            Mã quét khi vào/ra bãi đỗ xe
          </p>

          <div className="bg-slate-50 p-6 rounded-2xl border-2 border-dashed border-slate-300 inline-block mb-6 relative">
            {/* Giả lập QR Code bằng Icon lớn */}
            <QrCode size={120} strokeWidth={1} className="text-slate-800" />
            <div className="absolute top-1/2 left-0 w-full h-0.5 bg-blue-500/20 shadow-[0_0_8px_rgba(59,130,246,0.5)] animate-pulse"></div>
          </div>

