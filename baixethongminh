            <div className="flex justify-between">
              <span className="text-slate-500 text-sm">Biển số xe:</span>
              <span className="font-bold text-blue-700 text-sm font-mono">
                {bookingForm.plate}
              </span>
            </div>
            <div className="flex justify-between">
              <span className="text-slate-500 text-sm">Vị trí ô đỗ:</span>
